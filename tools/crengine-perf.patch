 };
 
+struct VertGlyphOrigin {
+    lInt32 x;
+    lInt32 y;
+    bool   found;
+};
+
+// Per-face cache of HarfBuzz TTB glyph origins.  hb-ft answers every
+// v-origin query with a full (usually auto-hinted) FT_Load_Glyph, which
+// made it dominate vertical layout and drawing time.  getFont() returns a
+// sub-font of `parent` whose v-origin callback memoizes the parent's
+// answers, so shaping results stay identical.  clear() must be called
+// before `parent` is destroyed or recreated.
+class LVFontVertOriginCache {
+public:
+    LVFontVertOriginCache() : _font(NULL), _cache(NULL) {}
+    ~LVFontVertOriginCache() { clear(); delete _cache; }
+
+    hb_font_t * getFont(hb_font_t * parent);
+    bool getOrigin(hb_font_t * parent, lUInt32 glyph_index, lInt32 & x, lInt32 & y);
+    void clear();
+
+private:
+    hb_font_t * _font;
+    LVHashTable<lUInt32, VertGlyphOrigin> * _cache;
+};
+
 #endif  // __LV_FNT_MAN_VERT_H_INCLUDED__
