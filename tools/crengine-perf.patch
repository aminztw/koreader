     // --- Opening brackets (class [1] in jfm-ujisv.lua) ---
     switch (c) {
         case 0x2018: // ‘
@@ -375,6 +381,8 @@ lChar32 getVertPresentationForm(lChar32 c)
     // unconditionally so the font's `vrt2` feature can produce composites.
     // For fonts without composite vrt2 mappings, +vert + the
     // needsVerticalRotation90CW fallback still gives correct vertical glyphs.
+    if (c < 0x3001 || (c > 0x3017 && c < 0xFF08) || c > 0xFF5D)
+        return c;
     switch (c) {
         // Punctuation
         case 0x3001: return 0xFE11; // 、 → ︑
@@ -743,3 +751,73 @@ void LVFontVertBodyMetricsCache::clear()
     if (_cache)
         _cache->clear();
 }
+
+static hb_bool_t getCachedVertOrigin(hb_font_t * font, void * font_data,
+                                     hb_codepoint_t glyph,
+                                     hb_position_t * x, hb_position_t * y,
+                                     void * user_data)
+{
+    LVFontVertOriginCache * cache = (LVFontVertOriginCache *)font_data;
+    lInt32 ox = 0;
+    lInt32 oy = 0;
+    bool found = cache->getOrigin(hb_font_get_parent(font), glyph, ox, oy);
+    *x = ox;
+    *y = oy;
+    return found;
+}
+
+static hb_font_funcs_t * createCachedVertOriginFuncs()
+{
+    hb_font_funcs_t * funcs = hb_font_funcs_create();
+    hb_font_funcs_set_glyph_v_origin_func(funcs, getCachedVertOrigin, NULL, NULL);
+    hb_font_funcs_make_immutable(funcs);
+    return funcs;
+}
+
+hb_font_t * LVFontVertOriginCache::getFont(hb_font_t * parent)
+{
+    if (!parent)
+        return parent;
+    if (_font && hb_font_get_parent(_font) != parent)
+        clear();
+    if (_font)
+        return _font;
+    static hb_font_funcs_t * funcs = createCachedVertOriginFuncs();
+    hb_font_t * font = hb_font_create_sub_font(parent);
+    if (font == hb_font_get_empty())
+        return parent;
+    // The sub-font copies the parent's scale, ppem and variations, and
+    // delegates everything else to it.
+    hb_font_set_funcs(font, funcs, this, NULL);
+    _font = font;
+    return _font;
+}
+
+bool LVFontVertOriginCache::getOrigin(hb_font_t * parent, lUInt32 glyph_index,
+                                      lInt32 & x, lInt32 & y)
+{
+    if (!_cache)
+        _cache = new LVHashTable<lUInt32, VertGlyphOrigin>(1024);
+    VertGlyphOrigin origin;
+    if (!_cache->get(glyph_index, origin)) {
+        hb_position_t ox = 0;
+        hb_position_t oy = 0;
+        origin.found = hb_font_get_glyph_v_origin(parent, glyph_index, &ox, &oy) != 0;
+        origin.x = ox;
+        origin.y = oy;
+        _cache->set(glyph_index, origin);
+    }
+    x = origin.x;
+    y = origin.y;
+    return origin.found;
+}
+
+void LVFontVertOriginCache::clear()
+{
+    if (_font) {
+        hb_font_destroy(_font);
+        _font = NULL;
+    }
+    if (_cache)
+        _cache->clear();
+}
